/*
 * ST77916 MIPI DSI LCD config dtsi (HSD 1.85 inch) for the MT108 (4.14 DRM binding)
 *
 * Converted from the stock node lcd77916185@77916185 of devices/mt108/stock.dts
 * (4.4 ADF binding, panel-name "lcd_st77916_mipi_hsd185",
 * lcd_id ID77916185). Encoding and binding notes: devices/dm63/PANEL_414.md
 * (same conversion), board notes devices/mt108/DTS_414.md. Nothing here has run
 * on a watch.
 *
 * SPDX-License-Identifier: (GPL-2.0+ OR MIT)
 */

/ { lcds {
	lcd_st77916_mipi_hsd185: lcd_st77916_mipi_hsd185 {

		sprd,dsi-work-mode = <0>; /* command mode (stock work-mode 0) */
		/*
		 * Stock bpp 18 (0x12): 4.4 bpp_to_coding() = COLOR_CODE_18BIT_CONFIG1,
		 * the packed 18 bit coding, which is "rgb666_packed" in 4.14
		 * ("rgb666" would be 24 bit coding there). The 4.14 dpu_lite_r1p0
		 * hard-codes a 24 bit DPI bus width (stock programs 18 bit), see
		 * devices/mt108/DTS_414.md: display stays disabled in the board DTS.
		 */
		sprd,dsi-color-format = "rgb666_packed";
		sprd,dsi-lane-number = <1>; /* stock lane-number 1 */

		/*
		 * Stock display-timings clock-frequency (0x518b0 = 334000) is the
		 * DSI bit clock in kbps in the 4.4 ADF driver (phy_freq), not a
		 * pixel clock.
		 */
		sprd,lcd-id = <0x77916185>;	/* stock lcd_id=ID77916185 */
		sprd,refresh-rate = <60>;	/* stock fps */
		sprd,phy-bit-clock = <334000>; /* kbps */

		/*
		 * stock need-check-esd 0: the esd check stays off, esd-timeout
		 * 1000 ms is stock, register and value are the 4.14 defaults
		 * (stock has no esd-check-reg).
		 */
		sprd,esd-check-enable = <0>;
		sprd,esd-check-mode = <0>; /* register check */
		sprd,esd-check-period = <1000>; /* stock esd-timeout, ms */
		sprd,esd-check-register = <0x0a>;
		sprd,esd-check-value = <0x9c>;

		/*
		 * Stock power-on-sequence (gpio level delay-ms): 50 1 20, 50 0 20, 50 1 50.
		 * Gpio 50 is the panel reset-gpio of the dsi child node in the
		 * board DTS; stock has no avdd gpio step for this panel.
		 * Stock power-off-sequence: 50 0 20.
		 */
		sprd,reset-on-sequence = <1 20>, <0 20>, <1 50>;
		sprd,reset-off-sequence = <0 20>;

		/* each command: data-type wait-ms len-hi len-lo payload */
		sprd,initial-command = [
			29 00 00 03 f0 00 28
			29 00 00 03 f2 00 28
			29 00 00 03 7c 00 d1
			29 00 00 03 83 00 e0
			29 00 00 03 84 00 61
			29 00 00 03 f2 00 82
			29 00 00 03 f0 00 00
			29 00 00 03 f0 00 01
			29 00 00 03 f1 00 01
			29 00 00 03 b0 00 39
			29 00 00 03 b1 00 3a
