			29 00 00 03 c7 00 88
			29 00 00 03 c8 00 99
			29 00 00 03 c9 00 33
			29 00 00 03 d0 00 11
			29 00 00 03 d1 00 aa
			29 00 00 03 d2 00 65
			29 00 00 03 d3 00 74
			29 00 00 03 d4 00 47
			29 00 00 03 d5 00 56
			29 00 00 03 d6 00 00
			29 00 00 03 d7 00 88
			29 00 00 03 d8 00 99
			29 00 00 03 d9 00 33
			29 00 00 03 f3 00 01
			29 00 00 03 f0 00 00
			13 00 00 01 21
			13 00 00 01 35
			13 48 00 01 11
			13 00 00 01 29
			13 05 00 01 00
			];

		sprd,sleep-in-command = [
			13 0a 00 01 28
			13 78 00 01 10
			];

		sprd,sleep-out-command = [
			13 78 00 01 11
			13 64 00 01 29
			];

		/*
		 * Command mode. Stock porches and hsync (hback 60, hfront 80,
		 * hsync 16, vback 8, vfront 8, vsync 2) are not used in command
		 * mode. The 4.14 DPU picks the command (edpi) interface only
		 * when hdisplay == htotal or vdisplay == vtotal, so the
		 * horizontal blanking is 0 here. Vertical values are stock.
		 * clock-frequency is the DPI clock: 128 MHz is the stock dispc
		 * clock-src[1] (0x7a12000), assumed to be what the 4.4 driver
		 * ran the command mode pixel interface at (not verified, same
		 * assumption as the CO5300 dtsi files).
		 */
		display-timings {
			timing0 {
				clock-frequency = <128000000>;
				hactive = <360>;
				vactive = <360>;
				hback-porch = <0>;
				hfront-porch = <0>;
				hsync-len = <0>;
				vback-porch = <8>;
				vfront-porch = <8>;
				vsync-len = <2>;
			};
		};
	};
}; };
