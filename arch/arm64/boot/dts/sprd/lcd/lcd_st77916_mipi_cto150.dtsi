			29 00 00 09 2b 00 00 00 00 00 01 00 67
			13 00 00 01 21
			29 00 00 03 3a 00 66
			13 00 00 01 35
			13 78 00 01 11
			13 00 00 01 29
			13 1a 00 01 00
			];

		sprd,sleep-in-command = [
			13 0a 00 01 28
			13 78 00 01 10
			];

		sprd,sleep-out-command = [
			13 78 00 01 11
			13 64 00 01 29
			];

		/*
		 * Video mode. Stock display-timings: hback 60 (0x3c), hfront 80
		 * (0x50), hsync 16, vback 8, vfront 8, vsync 2, 360x360, all
		 * used. clock-frequency is the DPI pixel clock and is derived,
		 * the stock node only has the 340000 kbps DSI bit clock and
		 * fps 50: htotal 516 * vtotal 378 * 50 = 9.75 MHz. The 4.4 ADF
		 * driver ran it from the 128 MHz dispc source with divider
		 * ROUND(128 MHz / 9.75 MHz) = 13, i.e. 9.846 MHz (50.5 fps).
		 * The 4.14 sharkle dpu_clk_init() needs a pixel clock that
		 * divides 96 / 128 / 153.6 MHz exactly (else it logs an error
		 * and takes 96 MHz); 9.6 MHz = 96 MHz / 10 (49.2 fps) is the
		 * nearest exact value. TODO check on hardware.
		 * 4.14 dpu_dpi_init() warns when vsync + vback < 32 (stock 10).
		 */
		display-timings {
			timing0 {
				clock-frequency = <9600000>;
				hactive = <360>;
				vactive = <360>;
				hback-porch = <60>;
				hfront-porch = <80>;
				hsync-len = <16>;
				vback-porch = <8>;
				vfront-porch = <8>;
				vsync-len = <2>;
			};
		};
	};
}; };
