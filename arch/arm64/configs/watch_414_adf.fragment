# ADF display stack (ported from the 4.4 product tree, see
# devices/ADF_414_PORT.md) instead of the DRM/KMS one. Merge on top of
# sprd_sharkle_defconfig + watch_414.fragment, then run olddefconfig.
#
# CONFIG_ADF_SPRD "depends on !DRM_SPRD" (drivers/video/adf/sprd/Kconfig)
# only blocks turning ADF_SPRD on *while* DRM_SPRD is already on in an
# interactive config session; a batch merge like this one still has to
# turn DRM_SPRD off itself first, or olddefconfig just drops the
# unsatisfiable CONFIG_ADF_SPRD=y line below instead of touching
# DRM_SPRD. Hence the explicit "is not set" here, not just the dependency.
# CONFIG_DRM_SPRD is not set
CONFIG_ADF=y
CONFIG_ADF_SPRD=y
CONFIG_DISP_LITE_R2P0=y

# Panel idle mode (AOD) and double-tap wake (DM63 cst0xx_ts, DW100U hyn_ts); inert until
# /sys/kernel/aod_idle/idle is written
CONFIG_SPRD_AOD_IDLE=y

# Camera (the 4.4 driver ported to 4.14, for the stock camera HAL; nodes in
# sp9832e-watch-camera.dtsi). Power domain: sprd_sharkle_defconfig's
# CONFIG_SPRD_CAM_PW_DOMAIN_R5P1.
CONFIG_SPRD_CAMERA=y
CONFIG_SPRD_CAMERA_DCAM_IF_R4P0=y
CONFIG_SPRD_CAMERA_ISP_R6P11=y
CONFIG_SPRD_CAMERA_CPP_LITE_R3P0=y
CONFIG_SPRD_CAMERA_CSI_R2P0V2=y
