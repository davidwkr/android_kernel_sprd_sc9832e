# Stock Android 8.1 userspace on 4.14. Merge on top of
# sprd_sharkle_defconfig + watch_414.fragment (+ watch_414_adf.fragment),
# then run olddefconfig.
#
# sprd_sharkle_defconfig comes from SPRD's Android 10 platform, which
# replaced these with eBPF traffic accounting and userspace lmkd (PSI).
# The stock 8.1 system and its kernel (/proc/config.gz of the DM63) use
# the old interfaces.

# Per-UID traffic stats and socket tagging for netd / NetworkStatsService.
# xt_qtaguid also registers itself as the "owner" match, so it needs
# xt_owner off, as on stock.
# CONFIG_NETFILTER_XT_MATCH_OWNER is not set
CONFIG_NETFILTER_XT_MATCH_QTAGUID=y

# In-kernel low memory killer, tuned by the 8.1 lmkd through
# /sys/module/lowmemorykiller/parameters
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_ANDROID_LOW_MEMORY_KILLER_AUTODETECT_OOM_ADJ_VALUES=y
CONFIG_ANDROID_LOW_MEMORY_KILLER_MEMINFO=y

# Final reclaim attempt from the OOM notifier before the native OOM killer
# picks a victim, killing up to 3 tasks at once, as stock
CONFIG_OOM_NOTIFIER=y
CONFIG_MULTIPLE_OOM_KILLER=y
CONFIG_MULTIPLE_OOM_KILL_COUNT=3

# libsuspend uses /sys/power/autosleep when present, as on stock
CONFIG_PM_AUTOSLEEP=y

# No cap on the wakelocks userspace may create through /sys/power/wake_lock,
# as stock
CONFIG_PM_WAKELOCKS_LIMIT=0

# As stock: PID namespaces only
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
# CONFIG_UTS_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_USER_NS is not set
# CONFIG_NET_NS is not set

# The stock vibrator HAL writes /sys/class/timed_output/vibrator/enable: the
# timed_output class plus the SPRD PMIC driver replace the input FF one on the
# same DT node
CONFIG_ANDROID_TIMED_OUTPUT=y
CONFIG_SPRD_VIBRATOR=y
# CONFIG_INPUT_SC27XX_VIBRA is not set
