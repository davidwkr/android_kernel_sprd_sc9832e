# DM63: Hynitron CST0xx on i2c-3 at 0x38 ("cst0xx,cst0xx_ts"), input
# device "cst0xx_ts"
CONFIG_TOUCHSCREEN_CST0XX=y
# Insurance for a DM63 revision with the Hynitron chip (hyn_ts, 0x5a node in
# the stock DT); both drivers fail probe cleanly when their chip is absent.
CONFIG_TOUCHSCREEN_CST9217=y
