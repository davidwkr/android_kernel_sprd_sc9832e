# Watch drivers ported from the 4.4 product tree. Merge on top of
# sprd_sharkle_defconfig, see devices/merge_watch_414.sh
CONFIG_TOUCHSCREEN_CST0XX=y
CONFIG_TOUCHSCREEN_CST9217=y
CONFIG_TOUCHSCREEN_BTL=y
CONFIG_SENSORS_SC7A22=y
CONFIG_INPUT_QMA6981_I2C=y
CONFIG_SENSORS_OCH1970=y
CONFIG_INPUT_SENSORS_HRS3XXX=y
CONFIG_HEARTRATE_HRS3918=y
CONFIG_HEARTRATE_HRS3300=y
CONFIG_INPUT_SENSORS_BD1XXX=y
CONFIG_HEARTRATE_BD1820=y
CONFIG_CHARGER_SC2720=y
CONFIG_FUEL_GAUGE_SC27XX=y

# DM63 display: the CO5300 panel driver needs a "power" supply, the board
# DTS gives it a fixed regulator without enable gpio (sprd,generic-mipi-panel).
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Thermal protection. cpu_thm/gpu_thm (sprd,sharkle-thermal, nvmem calibration
# cells already in sharkle.dtsi) and the IPA cluster0-cooling path used by the
# cpu-thmzone cooling-map in sp9832e-mach.dtsi (SPRD_CPU_COOLING,
# SPRD_CPU_COOLING_DEVICE, SPRD_DEDICATE_THERMAL, GENERIC_ADC_THERMAL for the
# board NTC, THERMAL_GOV_POWER_ALLOCATOR) are all already on in
# sprd_sharkle_defconfig; only the sensor driver itself was off. See
# devices/THERMAL_414.md.
CONFIG_SPRD_THERMAL=y

# Crown: stock rotary-encoder node already in the DM63/DM82/MT107/MT108 4.14
# DTS (K18 and the DW100U variants have no crown and no node).
CONFIG_INPUT_GPIO_ROTARY_ENCODER=y

# AP watchdog, sharkle-wdt node already unconditional in sharkle.dtsi. The
# driver does not auto-start the countdown at probe (userspace must open
# /dev/watchdog0 and start it); see devices/THERMAL_414.md for why this is
# safe with the stock userspace on this image.
CONFIG_WATCHDOG_CORE=y
CONFIG_SPRD_WATCHDOG=y

# TRUSTY: DT node already wired in sp9832e-1h10-dw100u.dtsi, shared by all
# sp9832e-1h10-* boards.
CONFIG_TRUSTY=y

# USB gadget configfs functions used by stock.
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_CONFIGFS_EEM=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_OBEX=y

# Mali Midgard r21p0 (T820, sharkle platform glue), the DDK version of the
# stock libGLES_mali.so (UK 11.0); see devices/MALI_R21P0.md. Built in like
# the rest of this config: the stock ramdisk's insmod of its 4.4 mali.ko
# then just fails.
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_PLATFORM_NAME="sharkle"
CONFIG_MALI_DEVFREQ=y

# SC2342 Wi-Fi, BT and FM clients (stock module names for the ramdisk insmod lines)
CONFIG_SPRDWL_NG=m
CONFIG_SPRD_BT_TTY_SIPC=m
CONFIG_SPRD_FM_SIPC=m

# DW100U Goodix fingerprint HAL interface (drivers/input/fingerprint/goodix,
# node in sp9832e-1h10-dw100u.dtsi); probes only where the node exists. It
# uses netlink protocol 29, which nothing else claims here (no IODEBUG).
CONFIG_INPUT_FINGERPRINT=y
CONFIG_GOODIX_TEE_FINGERPRINT=y
