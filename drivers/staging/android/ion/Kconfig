menuconfig ION
	bool "Ion Memory Manager"
	depends on HAVE_MEMBLOCK && HAS_DMA && MMU
	select GENERIC_ALLOCATOR
	select DMA_SHARED_BUFFER
	---help---
	  Chose this option to enable the ION Memory Manager,
	  used by Android to efficiently allocate buffers
	  from userspace that can be shared between drivers.
	  If you're not using Android its probably safe to
	  say N here.

config ION_TEST
	tristate "Ion Test Device"
	depends on ION
	help
	  Choose this option to create a device that can be used to test the
	  kernel and device side ION functions.

config ION_DUMMY
	bool "Dummy Ion driver"
	depends on ION
	help
	  Provides a dummy ION driver that registers the
	  /dev/ion device and some basic heaps. This can
	  be used for testing the ION infrastructure if
	  one doesn't have access to hardware drivers that
	  use ION.

config ION_TEGRA
	tristate "Ion for Tegra"
	depends on ARCH_TEGRA && ION
	help
	  Choose this option if you wish to use ion on an nVidia Tegra.

config ION_SPRD
	tristate "Ion for Spreadtrum"
	depends on ION
	help
	  Choose this option if you wish to use ion on an Spreadtrum chip.
	  Provides a ION driver that registers the /dev/ion device and
	  some base heaps.

config SPRD_ION_RESTRICT_PHYS
	bool "Restrict ION_SPRD_CUSTOM_PHYS to non-app callers"
	depends on ION_SPRD
	default n
	help
	  ION_SPRD_CUSTOM_PHYS returns the physical address of any dma-buf
	  the caller can import, which gives an ordinary app a physical
	  address oracle (useful for DMA-based attacks). With this option
	  the ioctl returns -EPERM to callers with a uid >= 10000 (Android
	  AID_APP), unless the caller has CAP_SYS_RAWIO or its uid is listed
	  in the sprd_ion.phys_allow_uids parameter. Callers below 10000
	  (root, system, media, cameraserver, camera, graphics ...) are not
	  affected, so the stock vendor HALs are expected to keep working.
	  Each denial logs the comm and uid (rate limited).
	  Trade-off: any app-uid process that legitimately uses the ioctl
	  breaks unless allow-listed. Not verified on hardware. If unsure,
	  say N.

config ION_POOL_CACHE_POLICY
	bool "Ion set page pool cache policy"
	depends on ION && X86
	default y if X86
	help
	  Choose this option if need to explicity set cache policy of the
	  pages in the page pool.

config ION_CLEAR_CARVEOUT
	bool "Ion clear buffer allocated from carveout heap"
 	depends on ION
	help
	  Choose this option if need to clear buffer allocated from carveout heap.
