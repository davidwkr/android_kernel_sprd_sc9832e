# UNTESTED starting point for Android 8.1. Refine from avc denials.
type aod_idled, domain;
type aod_idled_exec, exec_type, file_type;
init_daemon_domain(aod_idled)

# Binaries the script runs, all executed without a domain transition
# (rx_file_perms, no entrypoint except the shell):
#   /system/bin/sh (shell_exec, entrypoint, started by init)   -> shell_exec
#   toybox applets: date cat grep sed tr sleep mkfifo kill rm  -> toolbox_exec
#   log, getprop                                               -> toolbox_exec / system_file
#   logcat                                                     -> logcat_exec
#   dumpsys                                                    -> dumpsys_exec
# plus the script file itself (system_file / aod_idled_exec, read).
allow aod_idled shell_exec:file { rx_file_perms entrypoint };
allow aod_idled system_file:file rx_file_perms;
allow aod_idled toolbox_exec:file rx_file_perms;
allow aod_idled logcat_exec:file rx_file_perms;
allow aod_idled dumpsys_exec:file rx_file_perms;
allow aod_idled aod_idled_exec:file r_file_perms;

# fifo + pid file in /data/system (system uid)
allow aod_idled system_data_file:dir rw_dir_perms;
allow aod_idled system_data_file:fifo_file create_file_perms;
allow aod_idled system_data_file:file create_file_perms;

# the two sysfs nodes (label in genfscon)
type sysfs_aod_idle, fs_type, sysfs_type;
allow aod_idled sysfs_aod_idle:dir search;
allow aod_idled sysfs_aod_idle:file rw_file_perms;
allow init sysfs_aod_idle:file { getattr setattr write open };  # on boot chown/chmod, stop hook write

# logcat -b events: the logd socket (the logcat binary is above)
read_logd(aod_idled)
write_logd(aod_idled)		# the log command

# dumpsys power (binary above)
binder_use(aod_idled)
allow aod_idled power_service:service_manager find;
allow aod_idled system_server:binder call;
allow system_server aod_idled:fd use;
allow system_server aod_idled:fifo_file { read write getattr };

# getprop: persist.sys.aod_brightness / persist.sys.aod_idled.poll
type aod_idled_prop, property_type;
get_prop(aod_idled, aod_idled_prop)
